choice DISPLAY_ESP32S3_KORVO2_V3
    depends on BOARD_TYPE_ESP_KORVO2_V3
    prompt "ESP32S3_KORVO2_V3 LCD Type"
    default ESP32S3_KORVO2_V3_LCD_ST7789
    help
        LCD Display Type
    config ESP32S3_KORVO2_V3_LCD_ST7789
        bool "ST7789 240*280"
    config ESP32S3_KORVO2_V3_LCD_ILI9341
        bool "ILI9341 240*320"
endchoice

choice DISPLAY_ESP32S3_AUDIO_BOARD
    depends on BOARD_TYPE_WAVESHARE_S3_AUDIO_BOARD
    prompt "ESP32S3_AUDIO_BOARD LCD Type"
    default AUDIO_BOARD_LCD_JD9853
    help
        LCD Display Type
    config AUDIO_BOARD_LCD_JD9853
        bool "JD9853 320*172"
    config AUDIO_BOARD_LCD_ST7789
        bool "ST7789 240*320"
endchoice

choice DISPLAY_STYLE
    prompt "Select display style"
    default USE_DEFAULT_MESSAGE_STYLE
    help
        Select display style for Xiaozhi device

    config USE_DEFAULT_MESSAGE_STYLE
        bool "Enable default message style"

    config USE_WECHAT_MESSAGE_STYLE
        bool "Enable WeChat Message Style"

    config USE_EMOTE_MESSAGE_STYLE
        bool "Emote animation style"
        depends on BOARD_TYPE_ESP_BOX_3 || BOARD_TYPE_ECHOEAR || BOARD_TYPE_LICHUANG_DEV_S3
endchoice

choice WAKE_WORD_TYPE
    prompt "Wake Word Implementation Type"
    default USE_AFE_WAKE_WORD if (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4) && SPIRAM
    default WAKE_WORD_DISABLED
    help
        Choose the type of wake word implementation to use

    config WAKE_WORD_DISABLED
        bool "Disabled"
        help
            Disable wake word detection

    config USE_ESP_WAKE_WORD
        bool "Wakenet model without AFE"
        depends on IDF_TARGET_ESP32C3 || IDF_TARGET_ESP32C5 || IDF_TARGET_ESP32C6 || (IDF_TARGET_ESP32 && SPIRAM)
        help
            Support ESP32 C3、ESP32 C5 与 ESP32 C6, and (ESP32 with PSRAM)

    config USE_AFE_WAKE_WORD
        bool "Wakenet model with AFE"
        depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4) && SPIRAM
        help
            Support AEC if available, requires ESP32 S3 and PSRAM

    config USE_CUSTOM_WAKE_WORD
        bool "Multinet model (Custom Wake Word)"
        depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4) && SPIRAM
        help
            Requires ESP32 S3 and PSRAM

endchoice

config CUSTOM_WAKE_WORD
    string "Custom Wake Word"
    default "xiao tu dou"
    depends on USE_CUSTOM_WAKE_WORD
    help
        Custom Wake Word, use pinyin for Chinese, separated by spaces

config CUSTOM_WAKE_WORD_DISPLAY
    string "Custom Wake Word Display"
    default "小土豆"
    depends on USE_CUSTOM_WAKE_WORD
    help
        Greeting sent to the server after wake word detection

config CUSTOM_WAKE_WORD_THRESHOLD
    int "Custom Wake Word Threshold (%)"
    default 20
    range 1 99
    depends on USE_CUSTOM_WAKE_WORD
    help
        Custom Wake Word Threshold, range 1-99, the smaller the more sensitive, default 20

config SEND_WAKE_WORD_DATA
    bool "Send Wake Word Data"
    default y
    depends on USE_AFE_WAKE_WORD || USE_CUSTOM_WAKE_WORD
    help
        Send wake word data to the server as the first message of the conversation and wait for response

config USE_AUDIO_PROCESSOR
    bool "Enable Audio Noise Reduction"
    default y
    depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4) && SPIRAM
    help
        Requires ESP32 S3 and PSRAM

config USE_DEVICE_AEC
    bool "Enable Device-Side AEC"
    default n
        depends on USE_AUDIO_PROCESSOR && (BOARD_TYPE_ESP_BOX_3 || BOARD_TYPE_ESP_BOX || BOARD_TYPE_ESP_BOX_LITE \
        || BOARD_TYPE_LICHUANG_DEV_S3 || BOARD_TYPE_ESP_KORVO2_V3 || BOARD_TYPE_WAVESHARE_S3_TOUCH_AMOLED_1_75 || BOARD_TYPE_WAVESHARE_S3_TOUCH_LCD_1_83\
        || BOARD_TYPE_WAVESHARE_S3_TOUCH_AMOLED_2_06 || BOARD_TYPE_WAVESHARE_S3_TOUCH_LCD_4B || BOARD_TYPE_WAVESHARE_P4_WIFI6_TOUCH_LCD_4B || BOARD_TYPE_WAVESHARE_P4_WIFI6_TOUCH_LCD_7B \
        || BOARD_TYPE_WAVESHARE_P4_WIFI6_TOUCH_LCD_XC || BOARD_TYPE_ESP_S3_LCD_EV_Board_2 || BOARD_TYPE_YUNLIAO_S3 \
        || BOARD_TYPE_ECHOEAR || BOARD_TYPE_WAVESHARE_S3_TOUCH_LCD_3_49 || BOARD_TYPE_EP_CHAT_P4_ML307)
    help
        To work properly, device-side AEC requires a clean output reference path from the speaker signal and physical acoustic isolation between the microphone and speaker.

config USE_SERVER_AEC
    bool "Enable Server-Side AEC (Unstable)"
    default n
    depends on USE_AUDIO_PROCESSOR
    help
        To work perperly, server-side AEC requires server support

config USE_AUDIO_DEBUGGER
    bool "Enable Audio Debugger"
    default n
    help
        Enable audio debugger, send audio data through UDP to the host machine

config AUDIO_DEBUG_UDP_SERVER
    string "Audio Debug UDP Server Address"
    default "192.168.2.100:8000"
    depends on USE_AUDIO_DEBUGGER
    help
        UDP server address, format: IP:PORT, used to receive audio debugging data

config USE_ACOUSTIC_WIFI_PROVISIONING
    bool "Enable Acoustic WiFi Provisioning"
    default n
    help
        Enable acoustic WiFi provisioning, use audio signal to transmit WiFi configuration data

config RECEIVE_CUSTOM_MESSAGE
    bool "Enable Custom Message Reception"
    default n
    help
        Enable custom message reception, allow the device to receive custom messages from the server (preferably through the MQTT protocol)

menu "Camera Configuration"
    depends on !IDF_TARGET_ESP32

    config XIAOZHI_ENABLE_HARDWARE_JPEG_ENCODER
        bool "Enable Hardware JPEG Encoder"
        default y
        depends on SOC_JPEG_ENCODE_SUPPORTED
        help
            Use hardware JPEG encoder on ESP32-P4 to encode image to JPEG.
            See https://docs.espressif.com/projects/esp-idf/en/stable/esp32p4/api-reference/peripherals/jpeg.html for more details.

    config XIAOZHI_ENABLE_CAMERA_DEBUG_MODE
        bool "Enable Camera Debug Mode"
        default n
        help
            Enable camera debug mode, print camera debug information to the console.
            Only works on boards that support camera.

    config XIAOZHI_ENABLE_CAMERA_ENDIANNESS_SWAP
        bool "Enable software camera buffer endianness swapping (USE WITH CAUTION)"
        default n
        depends on !CAMERA_SENSOR_SWAP_PIXEL_BYTE_ORDER
        help
            This option treats the camera buffer as a uint16_t[] array and performs byte-swapping (endianness conversion) on each element.
            
            Should only be modified by development board integration engineers.
            
            **Incorrect usage may result in incorrect image colors!**
            
            ATTENTION: If the option CAMERA_SENSOR_SWAP_PIXEL_BYTE_ORDER is available for your sensor, please use that instead.
endmenu

menu "TAIJIPAI_S3_CONFIG"
    depends on BOARD_TYPE_TAIJI_PI_S3
    choice I2S_TYPE_TAIJIPI_S3
        prompt "taiji-pi-S3 I2S Type"
        default TAIJIPAI_I2S_TYPE_STD
        help
            I2S 类型选择
        config TAIJIPAI_I2S_TYPE_STD
            bool "I2S Type STD"
        config TAIJIPAI_I2S_TYPE_PDM
            bool "I2S Type PDM"
    endchoice

    config I2S_USE_2SLOT
    bool "Enable I2S 2 Slot"
    default y
    help
        启动双声道

endmenu

menu "XVSENFENG_ALARM"
    config USE_ALARM
        bool "启用闹钟功能"
        default y
        help
            启用闹钟功能
    config ALARM_USE_SD_CARD
        bool "闹钟使用SD卡存储"
        default n
        help
            闹钟数据存储在SD卡中
    config ALARM_SD_CARD_MOUNT_POINT
        string "闹钟SD卡挂载点"
        default "/sdcard"
        depends on ALARM_USE_SD_CARD
        help
            闹钟SD卡挂载点

    config USE_REMINDER_POLL
        bool "启用推理提醒 HTTP 轮询（待机播报）"
        default n
        help
            待机时轮询自建推理 API，命中后通过官方小智云 TTS 播报会议等提醒。
            首次启动可将下方默认 URL 写入 NVS；也可后续通过 NVS 工具修改。

    config REMINDER_POLL_DEFAULT_URL
        string "默认 poll_url（支持 {device_id} 占位符）"
        default ""
        depends on USE_REMINDER_POLL
        help
            首次启动且 NVS 无 poll_url 时自动写入。
            示例: https://your-host/v1/devices/{device_id}/reminders/pending
            ML307 4G 需公网 HTTPS 地址，不能用 192.168.x.x。

    config REMINDER_POLL_DEFAULT_ACK_URL
        string "默认 ack_url（留空则从 poll_url 推导）"
        default ""
        depends on USE_REMINDER_POLL
        help
            可选。留空时由 poll_url 将 /pending 替换为 /ack。

    config REMINDER_POLL_INTERVAL_SEC
        int "提醒轮询间隔（秒）"
        default 60
        range 30 3600
        depends on USE_REMINDER_POLL
        help
            设备 idle 且无会话时 HTTP 拉取待提醒的周期。默认 60 秒；间隔越短越耗电。

    config REMINDER_FEEDBACK_SEC
        int "主动提醒播报后听用户反馈时长（秒）"
        default 5
        range 0 120
        depends on USE_REMINDER_POLL
        help
            mcp_wake 提醒 TTS 结束后开麦监听；超时无反馈则关会话、恢复唤醒词。方案 D 默认 5 秒；设为 0 则 TTS 结束立即回 idle。

    config REMINDER_WAKE_PHRASE
        string "MCP 唤醒短语（delivery_mode=mcp_wake 时发给云的 detect）"
        default "查提醒"
        depends on USE_REMINDER_POLL
        help
            idle 主动推流时只发送此短句唤醒云端对话；完整文案由 MCP 从队列读取后 TTS。

    config REMINDER_DIRECT_WAKE_MAX_CHARS
        int "direct_wake 最大 detect 字符数（官方云限制）"
        default 32
        range 8 32
        depends on USE_REMINDER_POLL
        help
            官方小智云 listen/detect 仅接受短唤醒词，长文本会报错
            "detect is only for wake words"。超过此长度自动降级 mcp_wake。
            mcp_wake 只发 REMINDER_WAKE_PHRASE；完整 prompt 由屏幕显示。

    config REMINDER_ANNOUNCE_REPEAT
        int "单次投递内重诵次数"
        default 1
        range 1 5
        depends on USE_REMINDER_POLL
        help
            同一条提醒在一次投递里连续重诵的遍数（1=不重复）。
            注意: 对 direct_wake / alert_only 由固件控制文案，重诵生效；
            mcp_wake 的语音由云端 MCP 读服务器队列生成，重诵需在服务器侧实现。

    config REMINDER_DIAG_AUTO_HEAL
        bool "诊断异常时自动恢复 idle 音频（唤醒词+麦克风）"
        default y
        depends on USE_REMINDER_POLL
        help
            每 10 秒检查 W001/W002/W005 等异常；待机且 session=None 时自动 RestoreIdleReady。
            串口搜 "ANOMALY" / "auto_heal" 可追踪。

    config REMINDER_MQTT_WAKE
        bool "启用 MQTT 唤醒后立即 HTTP 拉取提醒"
        default y
        depends on USE_REMINDER_POLL
        help
            推理服务在 push 后向设备订阅主题发布唤醒消息，固件立即 GET /pending。
            与 HTTP 周期轮询并存（轮询作兜底）。ML307 4G 需 broker 公网可达。

    config REMINDER_DEFER_BUSY_WAKE
        bool "设备忙时合并并延后 MQTT 提醒拉取（R0）"
        default y
        depends on REMINDER_MQTT_WAKE
        help
            MQTT 唤醒到达但设备正在对话、响铃或投递其他提醒时，不丢弃事件；
            仅保留一个待处理标志，空闲后最多约 1 秒重试。关闭可恢复旧的忙时跳过行为。

    config REMINDER_BOOT_TRACE
        bool "开机阶段 BootTrace 诊断（串口过滤 BootTrace）"
        default n
        depends on USE_REMINDER_POLL
        help
            记录各启动阶段时间戳、堆内存、复位原因；WDT/ panic 后打印 REBOOT_AFTER 与 SUMMARY。

    config REMINDER_BOOT_DEFER_SEC
        int "唤醒词就绪后再启动 Reminder 网络（秒）"
        range 3 120
        default 5
        depends on USE_REMINDER_POLL
        help
            ori 路径：进 idle 即 EnableWakeWordDetection。
            本项仅延迟 HTTP 轮询与 MQTT 唤醒，在 wake=1 稳定运行此秒数后再连网。
            避开 AFE 初始化与 4G/MQTT 并发导致 WDT。

    config REMINDER_MQTT_WAKE_DEFAULT_BROKER
        string "默认 MQTT broker（host:port）"
        default "broker.emqx.io:1883"
        depends on REMINDER_MQTT_WAKE
        help
            首次启动写入 NVS reminder_mqtt.broker。本地调试可用公网 broker 或 ngrok tcp 1883。

    config REMINDER_MQTT_WAKE_DEFAULT_TOPIC
        string "MQTT 订阅主题（支持 {device_id}/{mac}/{mac_clean}）"
        default "xiaozhi/reminder/wake/{device_id}"
        depends on REMINDER_MQTT_WAKE
        help
            推理服务 push 后应向同一主题发布唤醒。
            占位符: {device_id}/{mac}=带冒号 MAC，{mac_clean}=无冒号小写 MAC。
            生产建议 v1/notify/{mac_clean}，并与服务器发布主题、Mosquitto ACL 三处一致。

    config REMINDER_MQTT_WAKE_DEFAULT_USERNAME
        string "MQTT 用户名（可留空）"
        default ""
        depends on REMINDER_MQTT_WAKE

    config REMINDER_MQTT_WAKE_DEFAULT_PASSWORD
        string "MQTT 密码（可留空）"
        default ""
        depends on REMINDER_MQTT_WAKE

    config REMINDER_MQTT_WAKE_DEFAULT_CLIENT_ID
        string "MQTT client_id（留空则用 xiaozhi-<MAC无冒号>；支持 {mac_clean}）"
        default ""
        depends on REMINDER_MQTT_WAKE
        help
            首次启动写入 NVS reminder_mqtt.client_id。broker 按 client_id 做 ACL 限制时填写。
            生产模板示例: esp32-{mac_clean}。

    config REMINDER_MQTT_WAKE_DERIVE_PASSWORD
        bool "派生 MQTT 密码（HMAC-SHA256(salt, mac_clean)）"
        default n
        depends on REMINDER_MQTT_WAKE
        help
            启用后忽略 NVS/默认密码，开机用 HMAC-SHA256(hex_decode(salt), mac_clean) 前 32 位 hex 作为密码。
            salt 为 64 字符 hex（32 字节）；输出 32 字符小写 hex。务必与 broker 侧算法一致。

    config REMINDER_MQTT_WAKE_SECRET_SALT
        string "派生密码用的 salt"
        default ""
        depends on REMINDER_MQTT_WAKE_DERIVE_PASSWORD
        help
            HMAC 的密钥种子（64 字符 hex，固件侧 hex 解码为 32 字节）。务必与 broker 侧 salt 完全一致。

    config REMINDER_MQTT_TLS_INSECURE
        bool "MQTT TLS 不校验服务器证书（开发/自签用）"
        default y
        depends on REMINDER_MQTT_WAKE
        help
            y: 8883 连接关闭证书校验（仅加密，开发用）。
            n: 启用服务器证书校验；固件嵌入 main/reminder/certs/mqtt_ca.pem 并上传至 ML307。
endmenu
endmenu
