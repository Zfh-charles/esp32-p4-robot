{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaozhi.local/contracts/p4.trace.v1.schema.json",
  "title": "Xiaozhi P4 Event/Effect trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "source", "sanitized", "events", "expected"],
  "properties": {
    "schema_version": {"const": "p4.trace.v1"},
    "trace_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fw_marker", "environment"],
      "properties": {
        "fw_marker": {"type": "string", "pattern": "^boot_trace_"},
        "environment": {"enum": ["log", "host", "replay", "hil"]},
        "captured_at": {"type": "string", "format": "date-time"}
      }
    },
    "sanitized": {"const": true},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/event"}
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effects", "m_plus", "m_minus", "invariants"],
      "properties": {
        "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "m_plus": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/presence"}},
        "m_minus": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/absence"}},
        "invariants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/invariant"}}
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "t_ms", "type"],
      "properties": {
        "seq": {"type": "integer", "minimum": 0},
        "t_ms": {"type": "integer", "minimum": 0},
        "type": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
        "payload": {"type": "object"}
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "type", "caused_by_event_seq"],
      "properties": {
        "seq": {"type": "integer", "minimum": 0},
        "type": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
        "caused_by_event_seq": {"type": "integer", "minimum": 0},
        "payload": {"type": "object"}
      }
    },
    "presence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "type", "min_count"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "target": {"enum": ["event", "effect"]},
        "type": {"type": "string", "minLength": 1},
        "min_count": {"type": "integer", "minimum": 1}
      }
    },
    "absence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "type", "max_count"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "target": {"enum": ["event", "effect"]},
        "type": {"type": "string", "minLength": 1},
        "max_count": {"const": 0}
      }
    },
    "invariant": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "before_type", "after_type"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "kind": {"const": "effect_order"},
            "before_type": {"type": "string", "minLength": 1},
            "after_type": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "target", "type"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "kind": {"const": "count"},
            "target": {"enum": ["event", "effect"]},
            "type": {"type": "string", "minLength": 1},
            "min_count": {"type": "integer", "minimum": 0},
            "max_count": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "effect_type", "event_type"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "kind": {"const": "cause_type"},
            "effect_type": {"type": "string", "minLength": 1},
            "event_type": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
