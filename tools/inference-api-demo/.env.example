# 推理提醒 API — 复制为 .env（勿提交 .env）
#
# 本地调试：配合 ngrok 暴露 HTTP，MQTT 用公网 broker（如 broker.emqx.io）
# 服务器部署：见 docs/reminder-mqtt-wake.md §4

# ── HTTP API ──────────────────────────────────────────
INFERENCE_API_HOST=0.0.0.0
# 生产建议 127.0.0.1，由 Nginx 反代 443
INFERENCE_API_PORT=8765

# 设备 MAC（与固件串口一致，小写冒号分隔）
DEMO_DEVICE_ID=30:ed:a0:e1:b5:28

# 1=启动时自动插入演示会议提醒；生产/联调必须 0
SEED_DEMO_ON_START=0

# ── MQTT 唤醒（push 后固件立即 GET /pending）──────────
# 须与固件 menuconfig / NVS reminder_mqtt 一致
MQTT_WAKE_ENABLED=1
MQTT_WAKE_BROKER=broker.emqx.io
# 自建 Mosquitto 时改为 mqtt.your-domain.com
MQTT_WAKE_PORT=1883
MQTT_WAKE_TOPIC_PREFIX=xiaozhi/reminder/wake
# 实际发布主题: {MQTT_WAKE_TOPIC_PREFIX}/{MAC}
# 例: xiaozhi/reminder/wake/30:ed:a0:e1:b5:28
# MQTT_WAKE_USERNAME=
# MQTT_WAKE_PASSWORD=
